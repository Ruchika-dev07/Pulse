# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas (leave blank to use in-memory storage)
MONGODB_URI=mongodb+srv://pulse-app:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=pulse

# Device: sim (no hardware) or serial (real ESP32)
DEVICE_MODE=sim
# SERIAL_PORT=COM5
# SERIAL_BAUD=115200

# Seconds to approve a payment or an unlock
APPROVAL_TIMEOUT=30

# Continuous check: lock the site when the wearable comes off.
# Set to false if the firmware doesn't send status lines yet.
CONTINUOUS_CHECK=true
SIGNAL_TIMEOUT=4
REMOVAL_GRACE=1.5
SESSION_MAX_MINUTES=30

# V2: ATECC608 signatures. false = accept unsigned approvals (V1 firmware).
# true = only approvals signed by the wearable's chip count. Forged signatures are always refused.
REQUIRE_SIGNATURE=false
# Chip public key, 128 hex chars. Leave unset to use chip 1 (01238D68A84D0601EE).
# DEVICE_PUBKEY=

# Capital One Nessie v2 (key from https://v2.nessieisreal.com/account). Blank = demo bank.
NESSIE_API_KEY=
NESSIE_URL=https://v2-prod-api.nessieisreal.com
# Only on the laptop running the Cloudflare tunnel: makes Pulse Nessie's decision hook.
# NESSIE_HOOK_URL=https://noheartnocart.biz/api/nessie/hook
