# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas (leave blank to use in-memory storage)
MONGODB_URI= mongodb+srv://pulse-app:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=pulse

# Device: sim (no hardware) or serial (real ESP32)
DEVICE_MODE=sim
# SERIAL_PORT=COM5
# SERIAL_BAUD=115200

# Seconds to approve a payment or an unlock
APPROVAL_TIMEOUT=30

# Continuous check: lock the site when the wearable comes off.
# Set to false if the firmware doesn't send status lines yet.
CONTINUOUS_CHECK=true
SIGNAL_TIMEOUT=4
REMOVAL_GRACE=1.5
SESSION_MAX_MINUTES=30
